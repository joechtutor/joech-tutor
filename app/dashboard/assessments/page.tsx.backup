'use client'

import Image from 'next/image'
import { useEffect, useState } from 'react'
import Link from 'next/link'

type Question = {
  id: string
  subject: string
  grade: number
  topic: string
  difficulty: string
  prompt: string
  options: string[]
}

type Assessment = {
  id: string
  title: string
  subject: string
  grade: number
  duration_minutes: number
  created_at: string
  assessment_questions?: {
    question_id: string
    position: number
  }[]
}

type Student = {
  id: string
  full_name: string
  grade: number
}

type Assignment = {
  assessment_id: string
  student_id: string
  assigned_at: string
  assessment_title?: string
  student_name?: string
}

export default function AssessmentsPage() {
  const [questions, setQuestions] = useState<Question[]>([])
  const [assessments, setAssessments] = useState<Assessment[]>([])
  const [students, setStudents] = useState<Student[]>([])
  const [assignments, setAssignments] = useState<Assignment[]>([])

  const [selectedQuestions, setSelectedQuestions] = useState<string[]>([])

  const [title, setTitle] = useState('')
  const [subject, setSubject] = useState('Mathematics')
  const [grade, setGrade] = useState('')
  const [duration, setDuration] = useState('30')

  const [selectedAssessment, setSelectedAssessment] = useState('')
  const [selectedStudent, setSelectedStudent] = useState('')

  const [loading, setLoading] = useState(true)
  const [assignmentsLoading, setAssignmentsLoading] = useState(true)

  const [message, setMessage] = useState('')
  const [assignmentMessage, setAssignmentMessage] = useState('')

  async function loadData() {
    try {
      const questionsResponse = await fetch('/api/questions')
      const questionsData = await questionsResponse.json()

      const assessmentsResponse = await fetch('/api/assessments')
      const assessmentsData = await assessmentsResponse.json()

      if (!questionsResponse.ok) {
        setMessage(
          questionsData.error || 'Unable to load questions'
        )
        return
      }

      if (!assessmentsResponse.ok) {
        setMessage(
          assessmentsData.error || 'Unable to load assessments'
        )
        return
      }

      setQuestions(questionsData.questions || [])
      setAssessments(assessmentsData.assessments || [])
    } catch {
      setMessage('Unable to connect to the server')
    } finally {
      setLoading(false)
    }
  }

  async function loadStudents() {
    try {
      const response = await fetch('/api/students/list')
      const data = await response.json()

      if (!response.ok) {
        setAssignmentMessage(
          data.error || 'Unable to load students'
        )
        return
      }

      setStudents(data.students || [])
    } catch {
      setAssignmentMessage(
        'Unable to connect to the student server'
      )
    }
  }

  async function loadAssignments() {
    try {
      const response = await fetch('/api/assignments')
      const data = await response.json()

      if (!response.ok) {
        setAssignmentMessage(
          data.error || 'Unable to load assignments'
        )
        return
      }

      setAssignments(data.assignments || [])
    } catch {
      setAssignmentMessage(
        'Unable to connect to the assignment server'
      )
    } finally {
      setAssignmentsLoading(false)
    }
  }

  useEffect(() => {
    loadData()
    loadStudents()
    loadAssignments()
  }, [])

  function toggleQuestion(id: string) {
    setSelectedQuestions((current) => {
      if (current.includes(id)) {
        return current.filter(
          (questionId) => questionId !== id
        )
      }

      return [...current, id]
    })
  }

  const filteredQuestions = questions.filter((question) => {
    const matchingSubject =
      question.subject === subject

    const matchingGrade =
      !grade || question.grade === Number(grade)

    return matchingSubject && matchingGrade
  })

  async function createAssessment(
    e: React.FormEvent
  ) {
    e.preventDefault()
    setMessage('')

    if (!title.trim()) {
      setMessage('Please enter an assessment title.')
      return
    }

    if (!grade) {
      setMessage('Please select a grade.')
      return
    }

    if (selectedQuestions.length === 0) {
      setMessage(
        'Please select at least one question.'
      )
      return
    }

    try {
      const response = await fetch(
        '/api/assessments',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            title,
            subject,
            grade: Number(grade),
            duration_minutes: Number(duration),
            question_ids: selectedQuestions,
          }),
        }
      )

      const data = await response.json()

      if (!response.ok) {
        setMessage(
          data.error ||
            'Unable to create assessment'
        )
        return
      }

      setMessage(
        'Assessment created successfully.'
      )

      setTitle('')
      setSelectedQuestions([])
      setGrade('')

      await loadData()
    } catch {
      setMessage(
        'Unable to connect to the server'
      )
    }
  }

  async function assignAssessment(
    e: React.FormEvent
  ) {
    e.preventDefault()
    setAssignmentMessage('')

    if (!selectedAssessment) {
      setAssignmentMessage(
        'Please select an assessment.'
      )
      return
    }

    if (!selectedStudent) {
      setAssignmentMessage(
        'Please select a student.'
      )
      return
    }

    try {
      const response = await fetch(
        '/api/assignments',
        {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify({
            assessment_id: selectedAssessment,
            student_id: selectedStudent,
          }),
        }
      )

      const data = await response.json()

      if (!response.ok) {
        setAssignmentMessage(
          data.error ||
            'Unable to assign assessment'
        )
        return
      }

      setAssignmentMessage(
        'Assessment assigned successfully.'
      )

      setSelectedAssessment('')
      setSelectedStudent('')

      await loadAssignments()
    } catch {
      setAssignmentMessage(
        'Unable to connect to the assignment server'
      )
    }
  }

  return (
    <main className="joech-dashboard">

      {/* HEADER */}

      <header className="joech-header">
        <div className="joech-header-inner">

          <Link
            href="/dashboard"
            style={{
              display: 'flex',
              alignItems: 'center',
              gap: 16,
              textDecoration: 'none',
            }}
          >
            <Image
              src="/joech-logo.jpg"
              alt="JOECH TUTOR Logo"
              width={68}
              height={68}
              priority
              style={{
                width: 68,
                height: 68,
                objectFit: 'cover',
                borderRadius: 10,
                display: 'block',
              }}
            />

            <div>
              <h1 className="joech-logo">
                JOECH TUTOR
              </h1>

              <p className="joech-motto">
                Excellence Beyond Borders
              </p>
            </div>
          </Link>

          <div className="joech-user">
            <Link
              href="/dashboard"
              className="joech-nav-link"
            >
              ← Dashboard
            </Link>
          </div>

        </div>
      </header>

      <div className="joech-main">

        {/* PAGE INTRODUCTION */}

        <section className="joech-welcome">
          <h1>Assessment Management</h1>

          <p>
            Create, manage, and assign assessments
            to your students.
          </p>
        </section>

        {/* CREATE ASSESSMENT */}

        <section className="joech-section">

          <div className="joech-section-heading">
            <div>
              <h2>Create Assessment</h2>

              <p>
                Build an assessment using questions
                from your JOECH TUTOR Question Bank.
              </p>
            </div>

            <div className="joech-selection-count">
              {selectedQuestions.length} selected
            </div>
          </div>

          <form
            onSubmit={createAssessment}
            className="joech-form"
          >

            <div className="joech-form-grid">

              <div className="joech-field">
                <label htmlFor="assessment-title">
                  Assessment Title
                </label>

                <input
                  id="assessment-title"
                  value={title}
                  onChange={(e) =>
                    setTitle(e.target.value)
                  }
                  placeholder="e.g. Grade 8 Mathematics Assessment"
                  className="joech-input"
                  required
                />
              </div>

              <div className="joech-field">
                <label htmlFor="subject">
                  Subject
                </label>

                <select
                  id="subject"
                  value={subject}
                  onChange={(e) => {
                    setSubject(e.target.value)
                    setSelectedQuestions([])
                  }}
                  className="joech-input"
                >
                  <option value="Mathematics">
                    Mathematics
                  </option>

                  <option value="English">
                    English
                  </option>
                </select>
              </div>

              <div className="joech-field">
                <label htmlFor="grade">
                  Grade
                </label>

                <select
                  id="grade"
                  value={grade}
                  onChange={(e) => {
                    setGrade(e.target.value)
                    setSelectedQuestions([])
                  }}
                  className="joech-input"
                  required
                >
                  <option value="">
                    Select grade
                  </option>

                  <option value="5">
                    Grade 5
                  </option>

                  <option value="6">
                    Grade 6
                  </option>

                  <option value="7">
                    Grade 7
                  </option>

                  <option value="8">
                    Grade 8
                  </option>

                  <option value="9">
                    Grade 9
                  </option>
                </select>
              </div>

              <div className="joech-field">
                <label htmlFor="duration">
                  Duration (minutes)
                </label>

                <input
                  id="duration"
                  type="number"
                  min="1"
                  max="180"
                  value={duration}
                  onChange={(e) =>
                    setDuration(e.target.value)
                  }
                  className="joech-input"
                  required
                />
              </div>

            </div>

            <div className="joech-question-header">

              <div>
                <h3>Select Questions</h3>

                <p>
                  Choose the questions students
                  will answer in this assessment.
                </p>
              </div>

              <div className="joech-selection-count">
                {selectedQuestions.length} selected
              </div>

            </div>

            {!grade ? (

              <div className="joech-empty">
                <strong>Select a grade</strong>

                <span>
                  Select a grade above to view
                  available questions.
                </span>
              </div>

            ) : filteredQuestions.length === 0 ? (

              <div className="joech-empty">
                <strong>
                  No questions available
                </strong>

                <span>
                  No questions are currently
                  available for this subject and
                  grade.
                </span>
              </div>

            ) : (

              <div className="joech-question-list">

                {filteredQuestions.map(
                  (question, index) => (

                    <label
                      key={question.id}
                      className={
                        selectedQuestions.includes(
                          question.id
                        )
                          ? 'joech-question selected'
                          : 'joech-question'
                      }
                    >

                      <div className="joech-question-top">

                        <input
                          type="checkbox"
                          checked={selectedQuestions.includes(
                            question.id
                          )}
                          onChange={() =>
                            toggleQuestion(
                              question.id
                            )
                          }
                        />

                        <span className="joech-question-number">
                          Question {index + 1}
                        </span>

                        <span className="joech-tag">
                          {question.topic}
                        </span>

                        <span className="joech-tag">
                          {question.difficulty}
                        </span>

                      </div>

                      <p className="joech-question-text">
                        {question.prompt}
                      </p>

                    </label>

                  )
                )}

              </div>
            )}

            <div className="joech-form-footer">

              <div>
                <strong>
                  {selectedQuestions.length}
                </strong>{' '}
                question
                {selectedQuestions.length === 1
                  ? ''
                  : 's'} selected
              </div>

              <button
                type="submit"
                className="joech-button joech-button-primary"
              >
                Create Assessment
              </button>

            </div>

          </form>

          {message && (
            <div className="joech-message">
              {message}
            </div>
          )}

        </section>

        {/* EXISTING ASSESSMENTS */}

        <section
          className="joech-section"
          style={{ marginTop: 30 }}
        >

          <div className="joech-section-heading">

            <div>
              <h2>Existing Assessments</h2>

              <p>
                View assessments already created
                in the system.
              </p>
            </div>

            <div className="joech-selection-count">
              {assessments.length} assessment
              {assessments.length === 1
                ? ''
                : 's'}
            </div>

          </div>

          {loading ? (

            <div className="joech-loading">
              Loading assessments...
            </div>

          ) : assessments.length === 0 ? (

            <div className="joech-empty">
              <strong>
                No assessments created yet.
              </strong>

              <span>
                Create your first assessment above.
              </span>
            </div>

          ) : (

            <div className="joech-assessment-grid">

              {assessments.map((assessment) => (

                <article
                  key={assessment.id}
                  className="joech-assessment-card"
                >

                  <div className="joech-assessment-card-header">

                    <h3>
                      {assessment.title}
                    </h3>

                  </div>

                  <div className="joech-assessment-details">

                    <div>
                      <span>Subject</span>

                      <strong>
                        {assessment.subject}
                      </strong>
                    </div>

                    <div>
                      <span>Grade</span>

                      <strong>
                        Grade {assessment.grade}
                      </strong>
                    </div>

                    <div>
                      <span>Duration</span>

                      <strong>
                        {assessment.duration_minutes}{' '}
                        minutes
                      </strong>
                    </div>

                    <div>
                      <span>Questions</span>

                      <strong>
                        {assessment
                          .assessment_questions
                          ?.length || 0}
                      </strong>
                    </div>

                  </div>

                  <Link
                    href={`/dashboard/assessments/${assessment.id}`}
                    className="joech-button joech-button-secondary"
                  >
                    View Assessment
                  </Link>

                </article>

              ))}

            </div>

          )}

        </section>

        {/* ASSIGN ASSESSMENT */}

        <section
          className="joech-section"
          style={{ marginTop: 30 }}
        >

          <div className="joech-section-heading">

            <div>
              <h2>Assign Assessment</h2>

              <p>
                Assign an existing assessment to a
                registered student.
              </p>
            </div>

          </div>

          <form
            onSubmit={assignAssessment}
            className="joech-form"
          >

            <div className="joech-form-grid">

              <div className="joech-field">

                <label htmlFor="assessment">
                  Assessment
                </label>

                <select
                  id="assessment"
                  value={selectedAssessment}
                  onChange={(e) =>
                    setSelectedAssessment(
                      e.target.value
                    )
                  }
                  className="joech-input"
                  required
                >

                  <option value="">
                    Select assessment
                  </option>

                  {assessments.map(
                    (assessment) => (

                      <option
                        key={assessment.id}
                        value={assessment.id}
                      >
                        {assessment.title} — Grade{' '}
                        {assessment.grade}
                      </option>

                    )
                  )}

                </select>

              </div>

              <div className="joech-field">

                <label htmlFor="student">
                  Student
                </label>

                <select
                  id="student"
                  value={selectedStudent}
                  onChange={(e) =>
                    setSelectedStudent(
                      e.target.value
                    )
                  }
                  className="joech-input"
                  required
                >

                  <option value="">
                    Select student
                  </option>

                  {students.map((student) => (

                    <option
                      key={student.id}
                      value={student.id}
                    >
                      {student.full_name} — Grade{' '}
                      {student.grade}
                    </option>

                  ))}

                </select>

              </div>

            </div>

            <div className="joech-form-footer">

              <div>
                <strong>
                  {students.length}
                </strong>{' '}
                registered student
                {students.length === 1
                  ? ''
                  : 's'}
              </div>

              <button
                type="submit"
                className="joech-button joech-button-primary"
              >
                Assign Assessment
              </button>

            </div>

          </form>

          {assignmentMessage && (
            <div className="joech-message">
              {assignmentMessage}
            </div>
          )}

        </section>

        {/* ASSIGNED ASSESSMENTS */}

        <section
          className="joech-section"
          style={{ marginTop: 30 }}
        >

          <div className="joech-section-heading">

            <div>
              <h2>Assigned Assessments</h2>

              <p>
                Review assessments assigned to
                students.
              </p>
            </div>

            <div className="joech-selection-count">
              {assignments.length} assigned
            </div>

          </div>

          {assignmentsLoading ? (

            <div className="joech-loading">
              Loading assignments...
            </div>

          ) : assignments.length === 0 ? (

            <div className="joech-empty">
              <strong>
                No assessments assigned yet.
              </strong>

              <span>
                Assigned assessments will appear
                here.
              </span>
            </div>

          ) : (

            <div className="joech-assignment-list">

              {assignments.map((assignment) => (

                <article
                  key={
                    assignment.assessment_id +
                    '-' +
                    assignment.student_id
                  }
                  className="joech-assignment-card"
                >

                  <div>

                    <h3>
                      {assignment.assessment_title ||
                        'Assessment'}
                    </h3>

                    <p>
                      <strong>Student:</strong>{' '}
                      {assignment.student_name ||
                        'Student'}
                    </p>

                    <p>
                      <strong>Assigned:</strong>{' '}
                      {new Date(
                        assignment.assigned_at
                      ).toLocaleDateString()}
                    </p>

                  </div>

                  <Link
                    href={`/dashboard/assessments/${assignment.assessment_id}`}
                    className="joech-button joech-button-secondary"
                  >
                    View Assessment
                  </Link>

                </article>

              ))}

            </div>

          )}

        </section>

        {/* FOOTER */}

               <footer className="joech-footer">
          <div className="footer-brand">
            <Image
              src="/joech-logo.jpg"
              alt="JOECH TUTOR"
              width={42}
              height={42}
              className="footer-logo"
            />

            <div>
              <strong>JOECH TUTOR</strong>
              <span>Excellence Beyond Borders</span>
            </div>
          </div>

          <div className="footer-text">
            Mathematics & English Assessment Platform
          </div>
        </footer>

      </div>

      <style jsx>{`

        * {
          box-sizing: border-box;
        }

        .joech-dashboard {
          min-height: 100vh;
          background:
            linear-gradient(
              180deg,
              #f7f9fc 0%,
              #f1f5fa 100%
            );
          color: #172033;
          font-family:
            Inter,
            ui-sans-serif,
            system-ui,
            -apple-system,
            BlinkMacSystemFont,
            "Segoe UI",
            sans-serif;
        }

        /* ==============================
           HEADER
        ============================== */

        .joech-header {
          position: sticky;
          top: 0;
          z-index: 50;
          background: rgba(255,255,255,.96);
          backdrop-filter: blur(12px);
          border-bottom: 1px solid #e5eaf1;
          box-shadow: 0 4px 18px rgba(23,32,51,.04);
        }

        .joech-header-inner {
          max-width: 1440px;
          min-height: 82px;
          margin: 0 auto;
          padding: 10px 36px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 30px;
        }

        .joech-logo {
          margin: 0;
          color: #082b59;
          font-size: 21px;
          line-height: 1.1;
          font-weight: 900;
          letter-spacing: .3px;
        }

        .joech-motto {
          margin: 4px 0 0;
          color: #0b5ed7;
          font-size: 10px;
          font-weight: 800;
          letter-spacing: .8px;
        }

        .joech-nav-link {
          display: inline-flex;
          align-items: center;
          min-height: 40px;
          padding: 0 15px;
          border: 1px solid #dce3ec;
          border-radius: 9px;
          background: #ffffff;
          color: #30435c;
          text-decoration: none;
          font-size: 12px;
          font-weight: 800;
          transition: all .18s ease;
        }

        .joech-nav-link:hover {
          border-color: #0b5ed7;
          color: #0b5ed7;
          background: #f4f8ff;
          transform: translateY(-1px);
        }

        /* ==============================
           MAIN
        ============================== */

        .joech-main {
          max-width: 1440px;
          margin: 0 auto;
          padding: 38px 36px 50px;
        }

        .joech-welcome {
          margin-bottom: 28px;
        }

        .joech-welcome h1 {
          margin: 0;
          color: #082b59;
          font-size: clamp(30px, 4vw, 40px);
          line-height: 1.15;
          font-weight: 900;
          letter-spacing: -1px;
        }

        .joech-welcome p {
          margin: 9px 0 0;
          color: #718096;
          font-size: 14px;
        }

        /* ==============================
           SECTIONS
        ============================== */

        .joech-section {
          overflow: hidden;
          background: #ffffff;
          border: 1px solid #e2e8f0;
          border-radius: 18px;
          box-shadow:
            0 8px 28px rgba(23,32,51,.055);
        }

        .joech-section-heading {
          display: flex;
          align-items: flex-start;
          justify-content: space-between;
          gap: 25px;
          padding: 27px 30px 24px;
          border-bottom: 1px solid #edf1f5;
          background:
            linear-gradient(
              180deg,
              #ffffff 0%,
              #fbfcfe 100%
            );
        }

        .joech-section-heading h2 {
          margin: 0;
          color: #172033;
          font-size: 21px;
          font-weight: 850;
        }

        .joech-section-heading p {
          margin: 6px 0 0;
          color: #7b8798;
          font-size: 12px;
          line-height: 1.6;
        }

        .joech-selection-count {
          flex-shrink: 0;
          padding: 8px 13px;
          border: 1px solid #cfe0f7;
          border-radius: 999px;
          background: #edf5ff;
          color: #0b5ed7;
          font-size: 11px;
          font-weight: 850;
          white-space: nowrap;
        }

        /* ==============================
           FORMS
        ============================== */

        .joech-form {
          padding: 30px;
        }

        .joech-form-grid {
          display: grid;
          grid-template-columns:
            minmax(280px, 2fr)
            repeat(3, minmax(150px, 1fr));
          gap: 18px;
        }

        .joech-field {
          display: flex;
          flex-direction: column;
          gap: 7px;
        }

        .joech-field label {
          color: #334155;
          font-size: 11px;
          font-weight: 850;
          letter-spacing: .25px;
        }

        .joech-input {
          width: 100%;
          min-height: 46px;
          padding: 0 13px;
          border: 1px solid #d7dee8;
          border-radius: 9px;
          outline: none;
          background: #ffffff;
          color: #172033;
          font-family: inherit;
          font-size: 13px;
          transition:
            border-color .18s ease,
            box-shadow .18s ease;
        }

        .joech-input::placeholder {
          color: #a0a9b7;
        }

        .joech-input:focus {
          border-color: #0b5ed7;
          box-shadow:
            0 0 0 3px rgba(11,94,215,.10);
        }

        select.joech-input {
          cursor: pointer;
        }

        /* ==============================
           QUESTION AREA
        ============================== */

        .joech-question-header {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 20px;
          margin-top: 32px;
          margin-bottom: 16px;
          padding-top: 25px;
          border-top: 1px solid #edf1f5;
        }

        .joech-question-header h3 {
          margin: 0;
          color: #172033;
          font-size: 17px;
          font-weight: 850;
        }

        .joech-question-header p {
          margin: 5px 0 0;
          color: #7b8798;
          font-size: 11px;
        }

        .joech-question-list {
          display: flex;
          flex-direction: column;
          gap: 10px;
          max-height: 570px;
          overflow-y: auto;
          padding: 4px;
        }

        .joech-question-list::-webkit-scrollbar {
          width: 7px;
        }

        .joech-question-list::-webkit-scrollbar-thumb {
          border-radius: 10px;
          background: #cbd5e1;
        }

        .joech-question {
          display: block;
          padding: 16px 17px;
          border: 1px solid #e2e8f0;
          border-radius: 12px;
          background: #ffffff;
          cursor: pointer;
          transition:
            border-color .18s ease,
            background .18s ease,
            box-shadow .18s ease,
            transform .18s ease;
        }

        .joech-question:hover {
          border-color: #b9d0ef;
          background: #fbfdff;
          transform: translateY(-1px);
        }

        .joech-question.selected {
          border-color: #0b5ed7;
          background: #f3f8ff;
          box-shadow:
            0 5px 16px rgba(11,94,215,.09);
        }

        .joech-question-top {
          display: flex;
          align-items: center;
          flex-wrap: wrap;
          gap: 8px;
        }

        .joech-question-top input {
          width: 17px;
          height: 17px;
          margin: 0 4px 0 0;
          accent-color: #0b5ed7;
          cursor: pointer;
        }

        .joech-question-number {
          color: #172033;
          font-size: 11px;
          font-weight: 850;
        }

        .joech-tag {
          padding: 5px 8px;
          border-radius: 6px;
          background: #f0f3f7;
          color: #617086;
          font-size: 9px;
          font-weight: 800;
          text-transform: capitalize;
        }

        .joech-question.selected .joech-tag {
          background: #e0edff;
          color: #0b5ed7;
        }

        .joech-question-text {
          margin: 12px 0 0 28px;
          color: #334155;
          font-size: 13px;
          line-height: 1.65;
        }

        /* ==============================
           FORM FOOTER
        ============================== */

        .joech-form-footer {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 20px;
          margin-top: 25px;
          padding-top: 20px;
          border-top: 1px solid #edf1f5;
          color: #718096;
          font-size: 12px;
        }

        .joech-form-footer strong {
          color: #172033;
          font-size: 16px;
        }

        .joech-button {
          display: inline-flex;
          align-items: center;
          justify-content: center;
          min-height: 43px;
          padding: 0 17px;
          border-radius: 9px;
          text-decoration: none;
          font-family: inherit;
          font-size: 11px;
          font-weight: 850;
          cursor: pointer;
          transition:
            transform .18s ease,
            box-shadow .18s ease,
            background .18s ease;
        }

        .joech-button:hover {
          transform: translateY(-1px);
        }

        .joech-button-primary {
          border: 0;
          background:
            linear-gradient(
              135deg,
              #082b59,
              #0b5ed7
            );
          color: #ffffff;
          box-shadow:
            0 7px 18px rgba(11,94,215,.20);
        }

        .joech-button-primary:hover {
          box-shadow:
            0 10px 24px rgba(11,94,215,.27);
        }

        .joech-button-secondary {
          border: 1px solid #cbd8e8;
          background: #ffffff;
          color: #0b5ed7;
        }

        .joech-button-secondary:hover {
          border-color: #0b5ed7;
          background: #f3f8ff;
        }

        /* ==============================
           EMPTY / LOADING
        ============================== */

        .joech-empty,
        .joech-loading {
          margin: 25px 30px 30px;
          padding: 45px 25px;
          display: flex;
          flex-direction: column;
          align-items: center;
          justify-content: center;
          text-align: center;
          border: 1px dashed #d4dce7;
          border-radius: 14px;
          background: #fafbfd;
        }

        .joech-empty strong {
          color: #334155;
          font-size: 14px;
        }

        .joech-empty span {
          max-width: 450px;
          margin-top: 7px;
          color: #8a95a5;
          font-size: 11px;
          line-height: 1.6;
        }

        .joech-loading {
          color: #718096;
          font-size: 12px;
        }

        .joech-message {
          margin: 0 30px 25px;
          padding: 13px 15px;
          border: 1px solid #cfe0f7;
          border-radius: 9px;
          background: #eef6ff;
          color: #0b5ed7;
          font-size: 12px;
          font-weight: 700;
        }

        /* ==============================
           ASSESSMENT CARDS
        ============================== */

        .joech-assessment-grid {
          display: grid;
          grid-template-columns:
            repeat(auto-fit, minmax(285px, 1fr));
          gap: 17px;
          padding: 27px 30px 30px;
        }

        .joech-assessment-card {
          position: relative;
          overflow: hidden;
          display: flex;
          flex-direction: column;
          min-height: 235px;
          padding: 21px;
          border: 1px solid #e1e7ef;
          border-radius: 14px;
          background: #ffffff;
          transition:
            transform .18s ease,
            box-shadow .18s ease,
            border-color .18s ease;
        }

        .joech-assessment-card::before {
          content: "";
          position: absolute;
          top: 0;
          left: 0;
          right: 0;
          height: 4px;
          background:
            linear-gradient(
              90deg,
              #082b59,
              #0b5ed7,
              #1677e8
            );
        }

        .joech-assessment-card:hover {
          transform: translateY(-3px);
          border-color: #cbd9eb;
          box-shadow:
            0 12px 30px rgba(23,32,51,.09);
        }

        .joech-assessment-card-header {
          min-height: 58px;
        }

        .joech-assessment-card h3 {
          margin: 4px 0 0;
          color: #172033;
          font-size: 15px;
          line-height: 1.45;
          font-weight: 850;
        }

        .joech-assessment-details {
          display: grid;
          grid-template-columns: 1fr 1fr;
          gap: 13px;
          margin: 18px 0 20px;
          padding: 14px;
          border-radius: 10px;
          background: #f7f9fc;
        }

        .joech-assessment-details div {
          display: flex;
          flex-direction: column;
          gap: 4px;
        }

        .joech-assessment-details span {
          color: #8a95a5;
          font-size: 9px;
          font-weight: 750;
          text-transform: uppercase;
          letter-spacing: .5px;
        }

        .joech-assessment-details strong {
          color: #334155;
          font-size: 11px;
        }

        .joech-assessment-card .joech-button {
          width: 100%;
          margin-top: auto;
        }

        /* ==============================
           ASSIGNMENT CARDS
        ============================== */

        .joech-assignment-list {
          display: flex;
          flex-direction: column;
          gap: 10px;
          padding: 27px 30px 30px;
        }

        .joech-assignment-card {
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 25px;
          padding: 19px 21px;
          border: 1px solid #e1e7ef;
          border-radius: 12px;
          background: #ffffff;
          transition:
            border-color .18s ease,
            box-shadow .18s ease;
        }

        .joech-assignment-card:hover {
          border-color: #cbd9eb;
          box-shadow:
            0 7px 20px rgba(23,32,51,.06);
        }

        .joech-assignment-card h3 {
          margin: 0 0 8px;
          color: #172033;
          font-size: 14px;
          font-weight: 850;
        }

        .joech-assignment-card p {
          margin: 4px 0;
          color: #718096;
          font-size: 11px;
        }

        .joech-assignment-card p strong {
          color: #44536a;
        }

        /* ==============================
           FOOTER
        ============================== */

        .joech-footer {
          min-height: 76px;
          margin-top: 35px;
          padding: 18px 5px;
          display: flex;
          align-items: center;
          justify-content: space-between;
          gap: 25px;
          border-top: 1px solid #dfe5ed;
          color: #7b8798;
          font-size: 11px;
        }

        .footer-brand {
          display: flex;
          align-items: center;
          gap: 10px;
        }

        .footer-logo {
          width: 38px;
          height: 38px;
          object-fit: cover;
          border-radius: 8px;
        }

        .footer-brand div {
          display: flex;
          flex-direction: column;
          gap: 2px;
        }

        .footer-brand strong {
          color: #172033;
          font-size: 11px;
          letter-spacing: .5px;
        }

        .footer-brand span {
          color: #0b5ed7;
          font-size: 9px;
          font-weight: 700;
        }

        .footer-text {
          color: #8993a5;
          font-size: 10px;
        }

        /* ==============================
           TABLET
        ============================== */

        @media (max-width: 1000px) {

          .joech-form-grid {
            grid-template-columns: 1fr 1fr;
          }

          .joech-form-grid
            .joech-field:first-child {
            grid-column: 1 / -1;
          }

        }

        /* ==============================
           MOBILE
        ============================== */

        @media (max-width: 700px) {

          .joech-header-inner {
            min-height: 70px;
            padding: 9px 17px;
          }

          .joech-header-inner img {
            width: 48px !important;
            height: 48px !important;
          }

          .joech-logo {
            font-size: 17px;
          }

          .joech-motto {
            font-size: 8px;
          }

          .joech-main {
            padding: 25px 15px 35px;
          }

          .joech-welcome h1 {
            font-size: 29px;
          }

          .joech-section-heading {
            flex-direction: column;
            padding: 22px 20px;
          }

          .joech-form {
            padding: 20px;
          }

          .joech-form-grid {
            grid-template-columns: 1fr;
          }

          .joech-form-grid
            .joech-field:first-child {
            grid-column: auto;
          }

          .joech-question-header {
            align-items: flex-start;
            flex-direction: column;
          }

          .joech-question-text {
            margin-left: 0;
          }

          .joech-form-footer {
            align-items: stretch;
            flex-direction: column;
          }

          .joech-form-footer .joech-button {
            width: 100%;
          }

          .joech-assessment-grid {
            grid-template-columns: 1fr;
            padding: 20px;
          }

          .joech-assignment-list {
            padding: 20px;
          }

          .joech-assignment-card {
            align-items: stretch;
            flex-direction: column;
            gap: 15px;
          }

          .joech-assignment-card .joech-button {
            width: 100%;
          }

          .joech-footer {
            align-items: flex-start;
            flex-direction: column;
          }

          .footer-text {
            font-size: 9px;
          }

        }

      `}</style>

    </main>
  )
}